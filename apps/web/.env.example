# ─── Core ────────────────────────────────────────────────────────────────────
# Local development uses SQLite (zero setup). Production uses Postgres on Neon:
#   DATABASE_URI=postgres://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URI=file:./csow.db

# Any long random string. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public origin of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Media storage (production: Cloudflare R2, S3-compatible) ─────────────────
# Leave S3_BUCKET empty in development to store uploads on local disk.
S3_BUCKET=
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL of the bucket (R2 custom domain or r2.dev URL), no trailing slash
MEDIA_PUBLIC_URL=

# ─── Seeding ─────────────────────────────────────────────────────────────────
# First admin user created by `pnpm seed` if no users exist
SEED_ADMIN_EMAIL=admin@csow.local
SEED_ADMIN_PASSWORD=change-me

# ─── AI providers (used by packages/ai; see docs/AI_PROVIDERS.md) ─────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
FAL_KEY=
REPLICATE_API_TOKEN=
# Optional: route every model through one key/gateway
AI_GATEWAY_API_KEY=
